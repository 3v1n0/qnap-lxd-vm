######################################################################
# Package routines for QNAP_LXD_VM.
#
# The modules, QEMU shim and UEFI firmware are all handled by the shared
# helper in shared/qnap-lxd-vm.sh, which the service program also calls.
######################################################################

QPKG_NAME="QNAP_LXD_VM"

# QTS runs these routines with the package's paths in the environment. Only fall
# back to the config file when they are not set: during an install, Install_Path
# is not written to qpkg.conf until the install has finished, so reading it
# there gives nothing and every path derived from it is wrong.
QPKG_ROOT=${QPKG_ROOT:-${QPKG_DIR:-$(/sbin/getcfg "$QPKG_NAME" Install_Path -f /etc/config/qpkg.conf)}}

# qbuild flattens shared/ into the package root, and while installing, the
# working directory is the directory the files were extracted to, so the helper
# is reachable relative to it as well.
vm_helper() {
    for candidate in \
        "$QPKG_ROOT/qnap-lxd-vm.sh" \
        "$QPKG_ROOT/shared/qnap-lxd-vm.sh" \
        ./qnap-lxd-vm.sh \
        ./shared/qnap-lxd-vm.sh
    do
        if [ -x "$candidate" ]; then
            printf '%s' "$candidate"
            return 0
        fi
    done

    printf '%s/qnap-lxd-vm.sh' "$QPKG_ROOT"
}

pkg_pre_install() {
    return 0
}

# Never fatal. Not finding the helper here just means the paths are not known
# yet; the service program checks again when the package starts, which is where
# it matters.
pkg_install() {
    if [ ! -x "$(vm_helper)" ]; then
        echo "qnap-lxd-vm: helper not found while installing; it will be looked up when the package starts" >&2
    fi

    return 0
}

# Load the modules right away so VMs work without a reboot.
#
# This deliberately does not reorder anything: QTS decides QPKG start order from
# the order of the sections in /etc/config/qpkg.conf, and moving ours would mean
# rewriting that file. See AGENTS.md for what that means in practice and for
# the opt-in helper that does it if you want it.
pkg_post_install() {
    if ! QNAP_LXD_VM_PREFIX="$QPKG_ROOT" "$(vm_helper)" install; then
        echo "qnap-lxd-vm: failed to load vsock support, see /var/lib/qnap-lxd-vm/qnap-lxd-vm.log" >&2
    fi

    return 0
}

pkg_pre_remove() {
    if [ -x "$(vm_helper)" ]; then
        QNAP_LXD_VM_PREFIX="$QPKG_ROOT" "$(vm_helper)" uninstall
    fi

    return 0
}

pkg_post_remove() {
    return 0
}
